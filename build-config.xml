	</runtime-shared-library-path>
	<static-link-runtime-shared-libraries>false</static-link-runtime-shared-libraries>

	<metadata>
		<title>GoAnimate Studio</title>
		<description>http://www.goanimate.com/</description>
		<publisher>GoAnimate</publisher>
		<creator>GoAnimate Team</creator>
