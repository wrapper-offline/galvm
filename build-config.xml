<?xml version="1.0" encoding="utf-8"?>
<flex-config>
	<compiler append="true">
		<library-path append="true">
			<path-element>./dist/libs/anifire.swc</path-element>
		</library-path>

		<locale>
			<locale-element>en_US</locale-element>
		</locale>

		<fonts>
			<managers>
				<manager-class>flash.fonts.CFFFontManager</manager-class>
			</managers>
		</fonts>
	</compiler>

	<verify-digests>false</verify-digests>

	<!-- NOTE: These are not 100% true to the original code. The RSLs defined
		in it longer pass signature verification, so they have been replaced
		with their unsigned equivalents.
	-->
	<runtime-shared-library-path>
		<path-element>${flexlib}/libs/apache.swc</path-element>
		<rsl-url>../../rsls/apache_4.16.1.20171115.swf</rsl-url>
	</runtime-shared-library-path>
	<runtime-shared-library-path>
		<path-element>${flexlib}/libs/framework.swc</path-element>
		<rsl-url>../../rsls/framework_4.16.1.20171115.swf</rsl-url>
	</runtime-shared-library-path>
