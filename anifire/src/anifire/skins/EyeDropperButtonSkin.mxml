<?xml version="1.0" encoding="utf-8"?>
<s:SparkButtonSkin xmlns:fx="http://ns.adobe.com/mxml/2009"
	xmlns:s="library://ns.adobe.com/flex/spark"
	alpha.disabled=".5">

	<s:states>
		<s:State name="up"/>
		<s:State name="over"/>
		<s:State name="down"/>
		<s:State name="disabled"/>
	</s:states>

	<s:BitmapImage
		verticalCenter="0"
		horizontalCenter="0"
		source="@Embed('../styles/images/icons/icon_colorpicker.png')"
		source.over="@Embed('../styles/images/icons/icon_colorpicker_active.png')"/>

</s:SparkButtonSkin>
