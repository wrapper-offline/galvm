<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009"
	xmlns:s="library://ns.adobe.com/flex/spark"
	width="100%"
	height="80"
	creationComplete="init()">

	<fx:Script>
		<![CDATA[
			import anifire.constant.CcLibConstant;
			import anifire.creator.events.CcSelectedDecorationEvent;
			import anifire.creator.models.CcCharacter;
			import anifire.creator.models.CcComponent;
			import mx.collections.ArrayCollection;
			import spark.components.List;
			import spark.events.IndexChangeEvent;
			import spark.events.ListEvent;

			public static const THUMB_INIT:String = "Init";
			public static const THUMB_OVER:String = "Over";
			private var _selectedThumb:CcComponentThumbThumbnail;
			[Bindable]
			private var _thumbnailSource:ArrayCollection;
			[Bindable]
			private var _decoratedList:Array = new Array();

			override public function set visible(value:Boolean) : void
			{
				super.visible = value;
				var numChildren:Number = Number(this.selectedList.numChildren);
				if (value) {
					this.selectedList.addEventListener(ListEvent.ITEM_ROLL_OVER, this.onThumbMouseOver);
					this.selectedList.addEventListener(ListEvent.ITEM_ROLL_OUT, this.onThumbMouseOut);
					this.selectedList.addEventListener(IndexChangeEvent.CARET_CHANGE, this.onThumbDown);
					this.selectedList.addEventListener(CcSelectedDecorationEvent.DECORATION_DELETED, this.onThumbDelete);
				} else {
					this.selectedList.removeEventListener(ListEvent.ITEM_ROLL_OVER, this.onThumbMouseOver);
					this.selectedList.removeEventListener(ListEvent.ITEM_ROLL_OUT, this.onThumbMouseOut);
					this.selectedList.removeEventListener(IndexChangeEvent.CARET_CHANGE, this.onThumbDown);
					this.selectedList.removeEventListener(CcSelectedDecorationEvent.DECORATION_DELETED, this.onThumbDelete);
				}
			}

			public function set selectedThumb(thumb:CcComponentThumbThumbnail) : void
			{
				var numChildren:Number = Number(this.selectedList.numChildren);
				for (var _loc3_:int = 0; _loc3_ < numChildren; _loc3_++) {}
				this._selectedThumb = thumb;
			}
			
			public function init() : void
			{
				this._decoratedList = new Array();
				this._thumbnailSource = new ArrayCollection();
				this._thumbnailSource.source = this._decoratedList;
			}
			
			public function initByCcChar(ccChar:CcCharacter) : void
			{
				this.init();
				for (var i:int = 0; i < ccChar.getUserChosenComponentSize(); i++) {
					var component:CcComponent = ccChar.getUserChosenComponentByIndex(i);
					if (CcLibConstant.ALL_MULTIPLE_COMPONENT_TYPES.indexOf(component.componentThumb.type) > -1) {
						this.addComponent(component);
					} 
				}
			}
			
			public function addComponent(component:CcComponent) : void
			{
				this.addThumbnail(component, component.componentThumb.type);
			}
			
			private function onThumbDelete(event:Event) : void
			{
				var evt:CcSelectedDecorationEvent;
				evt = new CcSelectedDecorationEvent(CcSelectedDecorationEvent.DECORATION_DELETED, this);
				evt.ccComponent = this._decoratedList[this.selectedList.selectedIndex];
				this.dispatchEvent(evt);
				this._decoratedList.splice(this.selectedList.selectedIndex, 1);
				if (this._decoratedList.length <= 0) {
					this._thumbnailSource = null;
				} else {
					this._thumbnailSource = new ArrayCollection();
					this._thumbnailSource.source = this._decoratedList;
				}
				this.selectedList.validateNow();
			}
			
			private function addThumbnail(component:CcComponent, _unused:String) : void
			{
				this._decoratedList.push(component);
				this._thumbnailSource = new ArrayCollection();
				this._thumbnailSource.source = this._decoratedList;
				this.selectedList.validateNow();
				this.selectedList.selectedIndex = this.selectedList.dataProvider.length - 1;
				this.selectedList.ensureIndexIsVisible(this.selectedList.dataProvider.length - 1);
			}
			
			private function onThumbDown(event:IndexChangeEvent) : void
			{
				if (event.newIndex > -1) {
					var component:CcComponent = this._decoratedList[event.newIndex];
					var evt:CcSelectedDecorationEvent = new CcSelectedDecorationEvent(CcSelectedDecorationEvent.DECORATION_CHOOSEN, this);
					evt.ccComponent = component;
					this.dispatchEvent(evt);
				}
			}
			
			private function onThumbMouseOver(event:ListEvent) : void
			{
				try {
					var component:CcComponent = this._decoratedList[event.itemIndex];
					var evt:CcSelectedDecorationEvent = new CcSelectedDecorationEvent(CcSelectedDecorationEvent.DECORATION_MOUSE_OVER, this);
					evt.ccComponent = component;
					this.dispatchEvent(evt);
				} catch (e:Error) {}
			}
			
			private function onThumbMouseOut(event:ListEvent) : void
			{
				try {
					var component:CcComponent = this._decoratedList[event.itemIndex];
					var evt:CcSelectedDecorationEvent = new CcSelectedDecorationEvent(CcSelectedDecorationEvent.DECORATION_MOUSE_OUT, this);
					evt.ccComponent = component;
					this.dispatchEvent(evt);
				} catch (e:Error) {}
			}
		]]>
	</fx:Script>

	<s:List
		id="selectedList"
		itemRenderer="anifire.creator.components.DecorationItemRenderer"
		width="100%"
		height="100%"
		borderVisible="false"
		contentBackgroundAlpha="0"
		verticalScrollPolicy="off"
		dataProvider="{ _thumbnailSource }">
		<s:layout>
			<s:HorizontalLayout paddingTop="5" paddingBottom="5" paddingLeft="15" paddingRight="15" gap="10"/>
		</s:layout>
	</s:List>

</s:Group>
