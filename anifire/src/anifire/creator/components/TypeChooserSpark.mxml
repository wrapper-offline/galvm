<?xml version="1.0" encoding="utf-8"?>
<s:HGroup
	xmlns:fx="http://ns.adobe.com/mxml/2009" 
	xmlns:s="library://ns.adobe.com/flex/spark" 
	xmlns:mx="library://ns.adobe.com/flex/mx"
	xmlns:components="anifire.creator.components.*"
	verticalAlign="middle"
	horizontalAlign="center">

	<fx:Script>
		<![CDATA[
			import anifire.constant.CcLibConstant;
			import anifire.creator.core.CcConsole;
			import anifire.creator.events.CcComponentTypeChooserEvent;
			import anifire.creator.models.CcCharacter;
			import anifire.creator.models.CcComponentThumb;
			import anifire.creator.models.CcTheme;
			import anifire.util.UtilDict;
			import anifire.util.UtilHashArray;
			import spark.events.IndexChangeEvent;

			private static var TRANSITION:String = "easeOut";
			private static var CAN_BG:String = "bg";
			private static var CAN_CIRCLE:String = "circle";
			private static var CAN_CURRENTICON:String = "currentIcon";
			private static var CAN_ICONIMAGE:String = "iconImage";
			private static var CAN_ICONPREVIOUS:String = "iconPrevious";
			private static var CAN_ICONNEXT:String = "iconNext";
			private var components:Array;
			private var currentComponentIndex:int;
			private var STEP_BUTTONS:Object;
			private var _propChanged:Object;

			override protected function createChildren() : void
			{
				super.createChildren();
			}
			
			public function init(ccTheme:CcTheme, param2:CcCharacter, param3:Boolean = true) : void
			{
				var _loc4_:Array = new Array();
				var _loc5_:Boolean = ccTheme.getBodyShapeNum() > 1;
				this.components = new Array();
				var typeOrder:Array;
				if (param2.bodyShape.getLibraryNum() == 0){
					typeOrder = CcLibConstant.COMPONENT_TYPE_CHOOSER_ORDERING_VER1;
				} else {
					typeOrder = CcLibConstant.COMPONENT_TYPE_CHOOSER_ORDERING_VER2;
				}
				for(var _loc7_:String in this.typeList.source)
				{
					var _loc8_:String = String(this.typeList.source[_loc7_].label);
					var _loc9_:Boolean = false;
					if(CcLibConstant.COMPONENT_TYPE_CHOOSER_COMPONENT_GROUP.indexOf(_loc8_) >= 0 || ccTheme.getAvailableComponentTypes().indexOf(_loc8_) > -1)
					{
						if(_loc8_ == CcLibConstant.COMPONENT_TYPE_BODYSHAPE)
						{
							if(_loc5_ && CcLibConstant.BODYSHAPE_CHOOSABLE || CcLibConstant.CHOOSE_TAG_TYPE_SEX)
							{
								_loc9_ = true;
							}
						}
						else
						{
							var _loc10_:UtilHashArray  = param2.bodyShape.getComponentThumbByType(_loc8_);
							if (!_loc10_) {
								_loc10_ = ccTheme.getComponentThumbByType(_loc8_);
							}
							var _loc11_:UtilHashArray = new UtilHashArray();
							if (_loc10_) {
								var _loc12_:int = 0;
								while(_loc12_ < _loc10_.length)
								{
									if(CcComponentThumb(_loc10_.getValueByIndex(_loc12_)).enable)
									{
										var _loc13_:Function = CcConsole.getCcConsole().configuration.defaultThumbFilter.filter;
										if(_loc13_(CcComponentThumb(_loc10_.getValueByIndex(_loc12_))))
										{
											_loc11_.push(_loc10_.getKey(_loc12_),_loc10_.getValueByIndex(_loc12_));
										}
									}
									_loc12_++;
								}
							}
							else
							{
								_loc11_ = null;
							}
							if(CcLibConstant.COMPONENT_TYPE_CHOOSER_COMPONENT_GROUP.indexOf(_loc8_) >= 0)
							{
								_loc9_ = true;
							}
							else
							{
								var _loc14_:Number = CcLibConstant.ALL_MULTIPLE_COMPONENT_TYPES.indexOf(_loc8_) > -1 ? 0 : 1;
								if(ccTheme.getAvailableComponentTypes().indexOf(_loc8_) > -1 && _loc11_ && _loc11_.length > _loc14_)
								{
									_loc9_ = true;
								}
							}
						}
					}
					if(_loc9_ && typeOrder.indexOf(_loc8_) > -1)
					{
						this.components.push(_loc8_);
						_loc4_.push(this.typeList.source[_loc7_]);
					}
				}
				this.confirmTypeList.source = _loc4_;
				this.currentComponentIndex = 0;
				this.switchToComponentType(this.components[this.currentComponentIndex],param3);
			}
			
			override public function styleChanged(styleProp:String) : void
			{
				super.styleChanged(styleProp);
				var allowed:Array = ["percentWidth", "navMarginRight"];
				if (styleProp == null || allowed.indexOf(styleProp) >= 0) {
					for each (var prop:String in allowed) {
						var style = getStyle(prop)
						if (style != undefined) {
							this._propChanged[prop] = style;
						}
					}
				}
			}

			/** Deprecated */
			private function prepare() : void {}

			/**
			 * Updates the selected type and refreshes the arrow buttons. If
			 * enabled, this function will also dispatch a
			 * <code>CcComponentTypeChooserEvent.COMPONENT_TYPE_CHOSEN</code>
			 * event.
			 */
			public function switchToComponentType(type:String = "", dispatch:Boolean = true) : void
			{
				this.currentComponentIndex = this.components.indexOf(type);
				this.canQuickBar.selectedIndex = this.currentComponentIndex;
				if (this.components.indexOf(type) == 0) {
					this.btnPrevious.enabled = false;
				} else {
					this.btnPrevious.enabled = true;
				}
				if (this.components.indexOf(type) == this.components.length - 1) {
					this.btnNext.enabled = false;
				} else {
					this.btnNext.enabled = true;
				}
				if (dispatch) {
					this.tellEverybodyComponentTypeChosen(type);
				}
			}
			
			private function tellEverybodyComponentTypeChosen(type:String) : void
			{
				var evt:CcComponentTypeChooserEvent = new CcComponentTypeChooserEvent(CcComponentTypeChooserEvent.COMPONENT_TYPE_CHOSEN,this);
				evt.componentType = type;
				this.dispatchEvent(evt);
			}
			
			private function onBtnClick(event:Event) : void
			{
				var i:int = 0;
				if (event.currentTarget == this.btnPrevious) {
					i = this.currentComponentIndex - 1;
				} else if (event.currentTarget == this.btnNext) {
					i = this.currentComponentIndex + 1;
				}
				if (i < this.components.length) {
					this.switchToComponentType(this.components[i]);
				}
			}
			
			private function onButtonBarChange(event:IndexChangeEvent) : void
			{
				var i:int = int(event.newIndex);
				if (i >= 0) {
					var type:String = String(this.confirmTypeList.source[i].label);
					this.switchToComponentType(type);
				}
			}
		]]>
	</fx:Script>

	<fx:Declarations>
		<s:ArrayList id="typeList">
			<fx:Object label="componentGroupClothes" icon="@Embed('/styles/images/assets/icon_upperbody.png')"/>
			<fx:Object label="GoUpper" icon="@Embed('/styles/images/assets/ico_upper_body.png')"/>
			<fx:Object label="GoLower" icon="@Embed('/styles/images/assets/ico_lower_body.png')"/>
			<fx:Object label="GoHands" icon="@Embed('/styles/images/assets/ico_hand.png')"/>
			<fx:Object label="GoFeet" icon="@Embed('/styles/images/assets/ico_shoe.png')"/>
			<fx:Object label="GoBehindBody" icon="@Embed('/styles/images/assets/ico_back_prop.png')"/>
			<fx:Object label="GoHair" icon="@Embed('/styles/images/assets/ico_hair.png')"/>
			<fx:Object label="upper_body" icon="@Embed('/styles/images/assets/ico_upper_body.png')"/>
			<fx:Object label="lower_body" icon="@Embed('/styles/images/assets/ico_lower_body.png')"/>
			<fx:Object label="faceshape" icon="@Embed('/styles/images/assets/ico_face.png')"/>
			<fx:Object label="hair" icon="@Embed('/styles/images/assets/ico_hair.png')"/>
			<fx:Object label="beard" icon="@Embed('/styles/images/assets/ico_beard.png')"/>
			<fx:Object label="mouth" icon="@Embed('/styles/images/assets/ico_mouth.png')"/>
			<fx:Object label="ear" icon="@Embed('/styles/images/assets/ico_ear.png')"/>
			<fx:Object label="mustache" icon="@Embed('/styles/images/assets/ico_mustache.png')"/>
			<fx:Object label="eye" icon="@Embed('/styles/images/assets/ico_eye.png')"/>
			<fx:Object label="eyebrow" icon="@Embed('/styles/images/assets/ico_eyebrow.png')"/>
			<fx:Object label="nose" icon="@Embed('/styles/images/assets/ico_nose.png')"/>
			<fx:Object label="glasses" icon="@Embed('/styles/images/assets/ico_glasses.png')"/>
			<fx:Object label="facedecoration" icon="@Embed('/styles/images/assets/ico_face_dec.png')"/>			
		</s:ArrayList>
	</fx:Declarations>

	<components:IconButton
		id="btnPrevious"
		buttonMode="true"
		enabled="false"
		icon="@Embed('/styles/images/typebar/step_arrowl_init.png')"
		iconOver="@Embed('/styles/images/typebar/step_arrowl_over.png')"
		iconDisabled="@Embed('/styles/images/typebar/step_arrowl_disabled.png')"
		label="{UtilDict.toDisplay('go', 'Previous')}"
		click="onBtnClick(event)"/>
	<s:Spacer width="18"/>

	<s:ButtonBar
		id="canQuickBar"
		x="0"
		height="45"
		visible="true"
		verticalCenter="0"
		requireSelection="true"
		skinClass="anifire.creator.skins.HButtonBarSkin"
		change="onButtonBarChange(event)">
		<s:dataProvider>
			<s:ArrayList id="confirmTypeList"/>
		</s:dataProvider>
	</s:ButtonBar>

	<s:Spacer width="18"/>
	<components:IconButton
		id="btnNext"
		buttonMode="true"
		enabled="false"
		icon="@Embed('/styles/images/typebar/step_arrowr_init.png')"
		iconOver="@Embed('/styles/images/typebar/step_arrowr_over.png')"
		iconDisabled="@Embed('/styles/images/typebar/step_arrowr_disabled.png')"
		label="{UtilDict.toDisplay('go', 'Next')}"
		click="onBtnClick(event)"/>

</s:HGroup>
