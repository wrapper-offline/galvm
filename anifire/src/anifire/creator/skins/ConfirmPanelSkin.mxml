<?xml version="1.0" encoding="utf-8"?>
<s:SparkSkin xmlns:fx="http://ns.adobe.com/mxml/2009"
	xmlns:s="library://ns.adobe.com/flex/spark"
	blendMode="normal"
	mouseEnabled="false"
	minWidth="300"
	minHeight="200">

	<fx:Metadata>
		[HostComponent("spark.components.Panel")]
	</fx:Metadata>

	<s:states>
		<s:State name="normal" stateGroups="normalStates"/>
		<s:State name="disabled" stateGroups="disabledStates"/>
		<s:State name="normalWithControlBar" stateGroups="withControls"/>
		<s:State name="disabledWithControlBar" stateGroups="withControls, disabledStates"/>
	</s:states>

	<s:RectangularDropShadow
		id="dropShadow"
		blurX="20"
		blurY="20"
		alpha="0.32"
		distance="11"
		angle="90"
		color="0"
		left="0"
		top="0"
		right="0"
		bottom="0"
		tlRadius="3"
		trRadius="3"
		blRadius="3"
		brRadius="3"/>
	<s:Group left="0" right="0" top="0" bottom="0">
		<s:Rect id="background" left="1" top="1" right="1" bottom="1" radiusX="3">
			<s:fill>
				<s:SolidColor id="backgroundFill" color="0xFFFFFF"/>
			</s:fill>
		</s:Rect>
		<s:Group id="contents" left="1" right="1" top="1" bottom="1" alpha.disabledStates="0.5">
			<s:layout>
				<s:VerticalLayout gap="0" horizontalAlign="justify"/>
			</s:layout>
			<s:VGroup
				id="topGroup"
				width="100%"
				minHeight="30"
				paddingLeft="28"
				paddingRight="28"
				paddingTop="15"
				paddingBottom="15"
				verticalAlign="middle"
				visible="{hostComponent.title != null}"
				includeInLayout="{hostComponent.title != null}">
				<s:Label
					id="titleDisplay"
					maxDisplayedLines="1"
					width="100%"
					fontSize="21"
					color="0x505E72"/>
			</s:VGroup>
			<s:Group id="contentGroup" width="100%" height="100%" minWidth="0" minHeight="0"/>
			<s:Group id="bottomGroup" minWidth="0" minHeight="0" includeIn="withControls">
				<s:Line top="0" left="0" right="0">
					<s:stroke>
						<s:SolidColorStroke color="0xE0E5EB"/>
					</s:stroke>
				</s:Line>
				<s:Group
					id="controlBarGroup"
					left="0"
					right="0"
					top="1"
					bottom="1"
					minWidth="0"
					minHeight="0">
					<s:layout>
						<s:HorizontalLayout
							horizontalAlign="center"
							gap="14"
							paddingLeft="14"
							paddingRight="14"
							paddingTop="14"
							paddingBottom="14"/>
					</s:layout>
				</s:Group>
			</s:Group>
		</s:Group>
	</s:Group>

</s:SparkSkin>
